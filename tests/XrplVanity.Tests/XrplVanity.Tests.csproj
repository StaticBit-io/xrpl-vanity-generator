<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\XrplVanity.Core\XrplVanity.Core.csproj" />
    <ProjectReference Include="..\..\src\XrplVanity.Cli\XrplVanity.Cli.csproj" />
    <ProjectReference Include="..\..\src\XrplVanity.Gpu\XrplVanity.Gpu.csproj" />
    <ProjectReference Include="..\..\src\XrplVanity.Search\XrplVanity.Search.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xrpl.Keypairs" Version="10.9.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <!-- Xrpl.Keypairs pulls in Portable.BouncyCastle (assembly BouncyCastle.Crypto), which defines the
         same Org.BouncyCastle.Math.EC.Rfc8032.Ed25519 type as BouncyCastle.Cryptography (assembly
         BouncyCastle.Cryptography) flowing transitively from XrplVanity.Core. Alias the latter so
         GpuPointTests can reference it unambiguously. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" Aliases="BcCrypto" />
  </ItemGroup>

</Project>
