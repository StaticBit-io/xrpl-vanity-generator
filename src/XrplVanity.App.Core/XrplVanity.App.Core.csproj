<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>_content/XrplVanity.App.Core</StaticWebAssetBasePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <ProjectReference Include="..\XrplVanity.Search\XrplVanity.Search.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="DartSassBuilder" Version="1.1.0" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <!-- One catalog per language; TextCatalog finds each by this exact name. -->
    <EmbeddedResource Include="Localization\Text\*.json" LogicalName="XrplVanity.App.Core.Localization.Text.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XrplVanity.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!--
    DartSassBuilder writes wwwroot\scss\*.css during the build (DartSass_Build runs before
    BeforeBuild), but MSBuild globbed wwwroot into Content when the project was evaluated. On a
    clean checkout the stylesheet did not exist yet, so it never became a static web asset, and a
    build published from a clean tree - the release ZIP built in CI, or a Store package built on a
    fresh machine - shipped without it and rendered unstyled. A developer machine hides this, because
    the file left over from the previous build is globbed. Add what the compiler wrote before the
    static web assets are resolved; the Remove keeps an incremental build, where the glob already
    found the file, from listing it twice.
  -->
  <Target Name="_IncludeCompiledSass" BeforeTargets="ResolveProjectStaticWebAssets">
    <ItemGroup>
      <Content Remove="wwwroot\scss\*.css" />
      <Content Include="wwwroot\scss\*.css" />
    </ItemGroup>
  </Target>

</Project>
