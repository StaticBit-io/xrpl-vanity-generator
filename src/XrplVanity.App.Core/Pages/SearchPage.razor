@page "/"
@inherits ViewModelPage
@inject TutorialService Tutorial

@* While the clear dialog is open the page behind it is inert, the way History
   leaves it: the controls it covers must not answer a stray click or a tab. *@
<header class="page-head" inert="@(_clearPending || _qrRows is not null)">
  <TutorialRegion Name="@TutorialRegions.Title">
    <h1>XRPL Vanity <StatusPill State="Vm.State" /></h1>
  </TutorialRegion>
  <TutorialRegion Name="@TutorialRegions.Start">
    <div class="actions">
      @if (Vm.State == SearchState.Idle)
      {
        <button class="btn-primary-mint start t" disabled="@(!Vm.CanStart)" @onclick="Vm.Start">Start</button>
        @if (Vm.TargetProblem is not null)
        {
          <div class="start-hint muted">@T.Render(Vm.TargetProblem)</div>
        }
      }
      else
      {
        <button class="btn-stop stop t" disabled="@(Vm.State == SearchState.Stopping)" @onclick="Vm.Stop">Stop</button>
      }
    </div>
  </TutorialRegion>
</header>
<div class="content-scroll" inert="@(_clearPending || _qrRows is not null)">
  @if (Vm.LastFailure is not null)
  {
    <Banner Kind="negative" Text="@T.Render(Vm.LastFailure)" />
  }
  <div class="search-grid">
    <div class="col">
      <TutorialRegion Name="@TutorialRegions.Patterns">
        <PatternEditor Vm="Vm" OnClearRequested="OpenClear" />
      </TutorialRegion>
      <TutorialRegion Name="@TutorialRegions.Estimate">
        <EstimateCard Vm="Vm" />
      </TutorialRegion>
    </div>
    <div class="col">
      <TutorialRegion Name="@TutorialRegions.Devices">
        <DevicePicker Vm="Vm" />
      </TutorialRegion>
      <TutorialRegion Name="@TutorialRegions.Duty">
        <DutySlider Vm="Vm" />
      </TutorialRegion>
    </div>
    <div class="col-bottom">
      <TutorialRegion Name="@TutorialRegions.Stats">
        <LiveStats Progress="Vm.Progress" />
      </TutorialRegion>
      @* A persist failure during a run must be visible here too: the session list still shows the
         hits, but they are not on disk and are gone on restart. *@
      @if (Vm.HistoryReadOnlyReason is not null)
      {
        <Banner Kind="negative" Text="@T.Render(Vm.HistoryReadOnlyReason)" />
      }
      <TutorialRegion Name="@TutorialRegions.Results">
        @* IsSandbox is read before Results: a sandbox that ends between the two reads then shows the
           user's results locked, never the practice ones unlocked. *@
        <ResultsList SecretsLocked="Vm.IsSandbox" Items="Vm.Results" ShowTarget="true" OnShowQr="ShowQr" RevealSeconds="Vm.Settings.SeedRevealSeconds" ClipboardClearSeconds="Vm.Settings.ClipboardClearSeconds" />
      </TutorialRegion>
    </div>
  </div>
</div>

<QrExportDialog Rows="_qrRows" OnClose="CloseQr" Note="@QrNote" />

<ConfirmDialog Visible="_clearPending" Title="@ClearTitle" Message="@ClearMessage" ConfirmLabel="Clear"
               OnConfirm="ConfirmClear" OnCancel="CloseClear" />
