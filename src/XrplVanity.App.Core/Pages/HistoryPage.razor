@page "/history"
@inherits ViewModelPage
@inject IResultStore Store

@* While a dialog is open the page behind it is inert: the destructive controls it covers —
   "Clear history" above all — must not stay reachable by keyboard or mouse. *@
<header class="page-head" inert="@(_pending is not null || _qrRows is not null)">
  <h1>History <span class="pill">@_all.Count stored</span></h1>
  <div class="actions">
    @if (!Store.IsReadOnly && _all.Count > 0)
    {
      <button class="btn-secondary-dark clear t" @onclick="AskClear">Clear history</button>
    }
  </div>
</header>
<div class="content-scroll" inert="@(_pending is not null || _qrRows is not null)">
  @if (Store.IsReadOnly)
  {
    <Banner Kind="negative" Text="@T.Render(Store.ReadOnlyReason ?? UiText.Of(HistoryText.ReadOnly))" />
  }
  @* A failed write turns the store read-only and throws with that same reason, so the banner
     above already carries it; showing both would stack two identical red lines. *@
  @if (_storeError is not null && !Store.IsReadOnly)
  {
    <Banner Kind="negative" Text="@_storeError" />
  }
  @* Two filters over one list, narrowing together: the text box searches free-form, the select
     picks one cell of the pattern column so a whole pattern can be selected and acted on at once. *@
  <div class="filter-row">
    <input class="filter form-control mono" placeholder="filter by address or pattern" @bind="_filter" @bind:event="oninput" />
    @if (_options.Count > 0)
    {
      <select class="pattern-filter form-select" aria-label="Filter by pattern" @bind="_patternKey">
        <option value="">All patterns — @_all.Count</option>
        @foreach (PatternOption option in _options)
        {
          <option value="@option.Key">@option.Display — @option.Count</option>
        }
      </select>
    }
  </div>
  @* KnownAddresses is the unfiltered universe on purpose: a row leaves the selection when it leaves the store, not when the filter hides it. *@
  <ResultsList Items="Filtered()" ShowTarget="true" Selectable="true" KnownAddresses="_knownAddresses"
               OnDelete="DeleteCallback" OnDeleteSelected="DeleteSelectedCallback" OnShowQr="rows => _qrRows = rows"
               RevealSeconds="Vm.Settings.SeedRevealSeconds" ClipboardClearSeconds="Vm.Settings.ClipboardClearSeconds" />
  @* The mockup replaces this footer with the red banner when results.dat cannot be read. *@
  @if (!Store.IsReadOnly && _storeError is null)
  {
    <div class="storage-note muted">Stored in <span class="mono">results.dat</span>, encrypted with Windows DPAPI for this user account. Nothing else on disk contains a seed.</div>
  }
</div>

<QrExportDialog Rows="_qrRows" OnClose="() => _qrRows = null" />

<ConfirmDialog Visible="@(_pending is not null)" Title="@(_pending?.Title ?? string.Empty)"
               Message="@(_pending is null ? string.Empty : _pending.Message())" Addresses="_pending?.Addresses"
               ConfirmLabel="@(_pending?.ConfirmLabel ?? "Delete")"
               OnConfirm="Confirm" OnCancel="Cancel" />
