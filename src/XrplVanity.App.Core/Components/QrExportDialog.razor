@using XrplVanity.Core
@inherits LocalizedComponent
@inject TimeProvider Clock

@if (Rows is { Count: > 0 })
{
  <div class="modal-backdrop"></div>
  <div class="modal-box card-box qr-box" role="dialog" aria-modal="true" aria-label="@T[QrText.Title]" aria-describedby="@(Note is null ? null : "qr-note")" tabindex="-1" @onkeydown="OnKeyDown" @ref="_box">
    <h3>@T[QrText.Title]</h3>
    @if (Note is not null)
    {
      <p id="qr-note" class="tutorial-note">@Note</p>
    }

    @* Buttons rather than radios: this application has no other radio group, and a button says
       plainly that choosing a format throws away whatever code is on screen. *@
    <div class="formats" role="group" aria-label="@T[QrText.FormatGroup]">
      <button class="format-backup t @(_seedOnly ? null : "active")" @onclick="() => SetFormat(false)">@T.Render(UiText.Of(QrText.FormatBackup, ("app", AppName), ("count", Rows.Count)))</button>
      <button class="format-seed t @(_seedOnly ? "active" : null)" disabled="@(Rows.Count != 1)" @onclick="() => SetFormat(true)">@T[QrText.FormatSeed]</button>
    </div>
    <div class="format-note">
      @if (Rows.Count != 1)
      {
        <text>@T[QrText.SeedNeedsOneWallet]</text>
      }
      else if (_seedOnly)
      {
        <LinkedText Text="@T.Render(UiText.Of(QrText.ScannedBySeed, ("app", AppName)))" Link="@AppName" Href="@AppUrl" />
      }
      else
      {
        <LinkedText Text="@T.Render(UiText.Of(QrText.ScannedByBackup, ("app", AppName)))" Link="@AppName" Href="@AppUrl" />
      }
    </div>

    @* The password and the folder belong to the backup format, and only while there is no code:
       once one is built they decide nothing, and leaving them on screen invites edits that go
       nowhere. Change puts them back. *@
    <div class="backup-fields @(_seedOnly || _code is not null ? "hidden" : null)">
      <div class="password-row">
        <input class="password form-control" type="password" placeholder="@T[QrText.PasswordPlaceholder]" @bind="_password" @bind:event="oninput" />
        <input class="password-confirm form-control" type="password" placeholder="@T[QrText.RepeatPlaceholder]" @bind="_passwordConfirm" @bind:event="oninput" />
      </div>
      <input class="folder form-control" maxlength="@StaticBitBackup.MaxFolderNameLength" placeholder="@T[QrText.FolderPlaceholder]" @bind="_folder" @bind:event="oninput" />
    </div>

    @* The button stands where the code will: showing, hiding and showing again all happen inside
       one box, so the dialog is exactly as tall before the code as after it. *@
    <div class="code-slot">
      @if (_code is null)
      {
        <button class="btn-primary-mint show-code t" disabled="@_building" @onclick="ShowCode">@T[_building ? QrText.Building : QrText.ShowCode]</button>
      }
      else
      {
        <QrCode Text="@_code" LogoUri="@LogoUri" />
      }
    </div>

    <div class="qr-warning @(ShowsWarning ? null : "hidden")">@T.Render(UiText.Of(QrText.NotEncrypted, ("count", Rows.Count)))</div>
    <div class="qr-caption @(_code is null ? "hidden" : null)"><LinkedText Text="@T.Render(UiText.Of(QrText.ScanCaption, ("app", AppName)))" Link="@AppName" Href="@AppUrl" /></div>
    <div class="qr-error @(_error is null ? "hidden" : null)">@T.Render(_error)</div>

    <div class="stores">
      <a class="store-ios" href="https://apps.apple.com/us/app/staticbit/id6745529426">App Store</a>
      <a class="store-android" href="https://play.google.com/store/apps/details?id=io.staticbit.wallet">Google Play</a>
    </div>

    <div class="buttons">
      @if (_code is not null && !_seedOnly)
      {
        <button class="btn-secondary-dark change-code t" @onclick="ChangeCode">@T[QrText.Change]</button>
      }
      <button class="btn-secondary-dark close t" @ref="_close" @onclick="() => OnClose.InvokeAsync()">@T[CommonText.Close]</button>
    </div>
  </div>
}
