@inherits ViewModelComponent
<div class="card-box">
  <div class="head"><div class="card-title">@T[DevicesText.DutyTitle]</div><span class="num duty-value">@T.Render(UiText.Of(DevicesText.DutyValue, ("percent", Vm.DutyPercent)))</span></div>
  <input type="range" min="25" max="100" step="5" value="@Vm.DutyPercent" @onchange="e => Vm.DutyPercent = int.Parse((string)e.Value!)" />
  <div class="note muted">@T.Render(UiText.Of(DevicesText.DutyNote, ("percent", 100 - Vm.DutyPercent)))</div>
</div>
