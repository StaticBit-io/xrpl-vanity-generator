@inherits LocalizedComponent
<div class="card-box">
  <div class="card-title">@T[SearchText.LiveTitle]</div>
  <div class="tiles">
    <div class="tile"><div class="label">@T[SearchText.LiveRate]</div><div class="num total-rate">@(Progress is null ? T[CommonText.NoValue] : Formatting.Rate(Progress.TotalRatePerSecond, T))</div></div>
    <div class="tile"><div class="label">@T[SearchText.LiveCandidates]</div><div class="num total-candidates">@(Progress is null ? T[CommonText.NoValue] : Formatting.Candidates(Progress.TotalCandidates, T))</div></div>
    <div class="tile"><div class="label">@T[SearchText.LiveElapsed]</div><div class="num elapsed">@(Progress is null ? T[CommonText.NoValue] : Formatting.Duration(Progress.Elapsed, T))</div></div>
    <div class="tile"><div class="label">@T[SearchText.LiveFound]</div><div class="num found">@(Progress is null ? T[CommonText.NoValue] : T.Number(Progress.Reported))</div></div>
  </div>
  @if (Progress is not null)
  {
    @foreach (TargetProgress t in Progress.Targets)
    {
      <div class="target-row @t.State.ToString().ToLowerInvariant()" @key="t.Id">
        <span class="id mono">@t.Id</span><span class="name">@t.Name</span>
        <span class="state">@T[StateLabel(t.State)]</span>
        <span class="num small">@Formatting.Rate(t.RatePerSecond, T)</span>
        @if (t.Failure is not null) { <span class="failure">@t.Failure</span> }
      </div>
    }
  }
</div>
