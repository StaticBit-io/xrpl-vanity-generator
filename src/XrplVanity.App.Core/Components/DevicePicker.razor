@inherits ViewModelComponent
<div class="card-box">
  <div class="head">
    <div class="card-title">@T[DevicesText.Title]</div>
    <div class="head-actions">
      <button class="btn-secondary-dark measure t" disabled="@(!Vm.CanMeasureSpeed)" @onclick="Vm.MeasureSpeed">@T[Vm.IsCalibrating ? DevicesText.Measuring : DevicesText.MeasureSpeed]</button>
      <button class="btn-icon t" title="@T[DevicesText.RefreshDevices]" @onclick="Vm.RefreshDevices">⟳</button>
    </div>
  </div>
  @if (Vm.NoGpuFound) { <div class="banner-yellow">@T[DevicesText.NoGpuFound]</div> }
  @foreach (TargetChoice t in Vm.Targets)
  {
    <label class="target t @(t.Selected ? "selected" : "")" @key="t.Id">
      <input class="select" type="checkbox" checked="@t.Selected" disabled="@Busy" @onchange="e => Vm.SetTargetSelected(t.Id, (bool)e.Value!)" />
      <span class="name">@t.Name @if (t.IsCpuDevice) { <span class="tag">@T[DevicesText.CpuTag]</span> }</span>
      <span class="details muted">@T.Render(t.Details)</span>
      @if (t.IsCpu)
      {
        <span class="threads-wrap"><input class="threads" type="range" min="1" max="@Environment.ProcessorCount" value="@Vm.CpuThreads" disabled="@Busy" @onchange="e => Vm.CpuThreads = int.Parse((string)e.Value!)" /> <span class="num small">@T.Render(UiText.Of(DevicesText.Threads, ("count", Vm.CpuThreads)))</span></span>
      }
      else
      {
        @* Two OpenCL devices of the same platform carry the same name; the selector id is the
           only thing that tells them apart. *@
        <span class="device-id mono muted">@t.Id</span>
      }
    </label>
  }
  @if (Vm.CalibrationFailure is not null) { <div class="banner-negative">@T.Render(Vm.CalibrationFailure)</div> }
</div>
