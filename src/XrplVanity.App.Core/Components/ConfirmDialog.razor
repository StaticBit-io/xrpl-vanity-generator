@inherits LocalizedComponent
@if (Visible)
{
  <div class="modal-backdrop"></div>
  <div class="modal-box card-box" role="dialog" aria-modal="true" aria-label="@Title" tabindex="-1" @onkeydown="OnKeyDown" @ref="_box">
    <h3>@Title</h3>
    <p>@Message</p>
    @if (Addresses is { Count: > 0 })
    {
      <div class="what mono">
        @foreach (string address in Addresses.Take(MaxListedAddresses))
        {
          <div>@address</div>
        }
        @if (Addresses.Count > MaxListedAddresses)
        {
          <div class="more">@T.Render(UiText.Of(DialogText.AndMore, ("count", Addresses.Count - MaxListedAddresses)))</div>
        }
      </div>
    }
    <div class="buttons">
      <button class="btn-danger confirm t" @onclick="() => OnConfirm.InvokeAsync()">@(ConfirmLabel ?? T[DialogText.Delete])</button>
      <button class="btn-secondary-dark cancel t" @ref="_cancel" @onclick="() => OnCancel.InvokeAsync()">@T[DialogText.Cancel]</button>
    </div>
  </div>
}
