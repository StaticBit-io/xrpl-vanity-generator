@using XrplVanity.Core
@inherits ViewModelComponent
@inject IFileDialogService Dialog
@{
  IReadOnlyList<PatternChip> chips = Vm.Patterns;
  bool collapsed = !_expanded && chips.Count > CollapseThreshold;
}
<div class="card-box">
  <div class="head">
    <div class="card-title">Patterns <span class="count">@chips.Count</span></div>
    <button class="clear-patterns btn-secondary-dark danger t" disabled="@(chips.Count == 0)" @onclick="() => OnClearRequested.InvokeAsync()">Clear</button>
  </div>
  <div class="chips @(_expanded ? "scrolling" : null)">
    @foreach (PatternChip chip in collapsed ? chips.Take(CollapsedChips) : chips)
    {
      <span class="chip t" @key="chip">
        @if (chip.Position == MatchPosition.Pair)
        {
          <span class="chip-pos">starts</span>
          <span class="mono">@chip.Text</span>
          <span class="chip-pos">ends</span>
          <span class="mono">@chip.EndsText</span>
        }
        else if (chip.Position == MatchPosition.NearStart)
        {
          <span class="chip-pos">starts</span>
          <span class="mono">@chip.Text</span>
          <span class="chip-pos chip-near" title="may begin at the 2nd or 3rd character of the address">2nd–3rd</span>
        }
        else
        {
          <span class="chip-pos">@chip.Position.ToString().ToLowerInvariant()</span>
          <span class="mono">@chip.Text</span>
        }
        @if (chip.Normalized is not null) { <span class="chip-normalized mono" title="0, O, I and l do not exist in the XRPL alphabet, so they are folded onto o, o, i and L">→ @chip.Normalized</span> }
        @if (!chip.IgnoreCase) { <span class="chip-pos" title="case-sensitive">Aa</span> }
        @if (chip.Warning is not null) { <span class="chip-warn">@chip.Warning</span> }
        @if (chip.NearStartSpeedup is double speedup)
        {
          <button class="chip-speedup t" title="The first character can rarely follow the r. Allow the pattern at the 2nd or 3rd character of the address." @onclick="() => Vm.AllowNearStart(chip)">≈@(speedup.ToString("0"))× sooner at 2nd–3rd</button>
        }
        <button class="remove" title="Remove" @onclick="() => Vm.RemovePattern(chip)">×</button>
      </span>
    }
  </div>
  @* A long set is cut to two rows or so; expanded, the area scrolls rather than pushing the cards
     below it off the page. The toggle sits outside that area on purpose: inside it, "show less"
     would scroll away with the chips and a long set could only be folded from its very bottom. *@
  @if (chips.Count > CollapseThreshold)
  {
    <div class="chips-row">
      <button class="chips-toggle t" @onclick="() => _expanded = !_expanded">@(collapsed ? $"+{chips.Count - CollapsedChips} more" : "show less")</button>
    </div>
  }
  <div class="entry pattern-entry @(Vm.EntryPosition switch { MatchPosition.Pair => "paired", MatchPosition.Starts => "with-near", _ => null })">
    <select class="pos form-select" @bind="Vm.EntryPosition">
      <option value="Starts">starts with</option>
      <option value="Ends">ends with</option>
      <option value="Contains">contains</option>
      <option value="Pair">starts and ends with</option>
    </select>
    @if (Vm.EntryPosition == MatchPosition.Pair)
    {
      <input class="pattern form-control mono" placeholder="starts with…" @bind="Vm.EntryText" @bind:event="oninput" @onkeydown="OnKeyDown" />
      <input class="pattern-ends form-control mono" placeholder="ends with…" @bind="Vm.EntryEndsText" @bind:event="oninput" @onkeydown="OnKeyDown" />
    }
    else
    {
      <input class="pattern form-control mono" placeholder="type a pattern and press Enter" @bind="Vm.EntryText" @bind:event="oninput" @onkeydown="OnKeyDown" />
    }
    <label class="case-label"><input class="case" type="checkbox" @bind="Vm.EntryIgnoreCase" /> ignore case</label>
    @if (Vm.EntryPosition == MatchPosition.Starts)
    {
      <label class="near-label" title="The pattern may begin at the 2nd or 3rd character of the address: r?WORD…"><input class="near-start" type="checkbox" @bind="Vm.EntryNearStart" /> 2nd or 3rd char</label>
    }
    <label class="btn-secondary-dark t">
      load list…
      <InputFile OnChange="OnListChosen" accept=".txt" style="display:none" />
    </label>
    <button class="save-list btn-secondary-dark t" disabled="@(chips.Count == 0)" @onclick="OnSaveList">save list…</button>
  </div>
  @if (_listError is not null)
  {
    <div class="list-error">@_listError</div>
  }
  @if (_listNote is not null)
  {
    <div class="list-note">@_listNote</div>
  }
  @if (Vm.PatternProblem is not null)
  {
    <div class="pattern-problem">@Vm.PatternProblem</div>
  }
  @if (Vm.PatternHint is not null)
  {
    <div class="pattern-hint">@Vm.PatternHint</div>
  }
  @if (Vm.NearStartHint is not null)
  {
    <div class="near-start-hint">@Vm.NearStartHint</div>
  }
</div>
