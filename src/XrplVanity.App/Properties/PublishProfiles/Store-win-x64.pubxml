<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\publish-store\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <SelfContained>true</SelfContained>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <!--
      The only setting that actually distinguishes a Store build from the sideload one. The Store
      signs the package with its own certificate once the submission is accepted, and rejects a
      package signed by anyone else, so no thumbprint is needed and app/make-cert.ps1 is irrelevant
      here.
    -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageDir>bin\msix-store\</AppxPackageDir>
    <!--
      Deliberately NOT setting UapAppxPackageBuildMode=StoreUpload. It looks like the way to get a
      .msixupload, but it is dead configuration in this project: every store-upload branch in
      Microsoft.Windows.SDK.BuildTools.MSIX.Packaging.targets is gated on
      AppxPackagePipelineVersion == UapBuildPipeline, which is only set for UWP projects (non-empty
      SDKIdentifier). A MAUI / Windows App SDK project runs the standard pipeline, so the property
      is silently ignored and the build still emits a plain .msix. Partner Center accepts that
      .msix directly, so nothing is lost - but a build that "succeeds" while ignoring the setting is
      worth calling out so it is not re-added.
    -->
  </PropertyGroup>
</Project>
