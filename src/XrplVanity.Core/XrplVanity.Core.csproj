<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>StaticBit.XrplVanity.Core</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Authors>StaticBit</Authors>
    <Description>Searches for XRP Ledger Ed25519 vanity addresses on the CPU, in managed code, with no GPU dependency.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/StaticBit-io/xrpl-vanity-generator</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XrplVanity.Tests" />
  </ItemGroup>

</Project>
